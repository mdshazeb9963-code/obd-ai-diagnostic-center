# Copy to .env and replace every value marked GENERATE or CHANGE.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
DATABASE_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=GENERATE_32_RANDOM_BYTES_AND_BASE64_ENCODE
WEB_PORT=5173
SECURE_COOKIE=false
ALLOWED_ORIGINS=http://localhost:5173

# Optional administrator account. Leave both empty to disable automatic bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional integrations. The platform reports unresolved DTCs until a provider is configured.
OBD_DIAGNOSTIC_PROVIDER_URL=
OBD_DIAGNOSTIC_PROVIDER_URLS=
OBD_DIAGNOSTIC_PROVIDER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
